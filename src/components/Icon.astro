  'arrow-down': 'M10.4 3.5v11.1l-4.2-4.2-2.3 2.3 8.1 8.1 8.1-8.1-2.3-2.3-4.2 4.2V3.5z',
  play: 'M7 4.2v15.6L19.5 12z',
  phone:
    'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z',
  message: 'M3 4h18v13H9.5L4.6 21v-4H3z',
  mail: 'M2.5 5h19v14h-19zM4.8 7.2 12 12l7.2-4.8z',
  plus: 'M10.4 3.5h3.2v6.9h6.9v3.2h-6.9v6.9h-3.2v-6.9H3.5v-3.2h6.9z',
  drag: 'M8.6 6.4 3 12l5.6 5.6v-3.9h6.8v3.9L21 12l-5.6-5.6v3.9H8.6z',
