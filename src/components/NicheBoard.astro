---
import Icon from './Icon.astro';
import { niches } from '../data/site.js';

const CELLS = Math.max(...niches.map((n) => n.board.length));
const pad = (s) => s.padEnd(CELLS, ' ').split('');
const first = niches[0];
---
<section class="niches section" id="work" aria-labelledby="niches-title">
  <div class="wrap">
    <div class="niches__intro">
      <h2 id="niches-title" class="h2">Watch edits we made for businesses like yours.</h2>
      <p class="lede">Real client videos. Pick your trade, then tap a video to play it.</p>
    </div>

    <div class="board on-dark" data-board>
      <div class="board__head">
        <span class="label board__now" aria-hidden="true">Now showing</span>
        <p class="flap" data-flap aria-hidden="true" style={`--cells:${CELLS}`}>
          {pad(first.board).map((ch) => (
            <span class="flap__cell"><span class="flap__ch">{ch === ' ' ? ' ' : ch}</span></span>
          ))}
        </p>
      </div>
      <div class="board__tabs" data-tablist role="group" aria-label="Choose a trade">
        {niches.map((n, i) => (
          <button
            type="button"
            class="board__tab"
            id={`tab-${n.id}`}
            aria-controls={`panel-${n.id}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-tab
            data-board-text={n.board}
            data-aliases={[n.id, ...n.aliases].join(' ')}
          >
            <span>{n.tab}</span>
            <Icon name="arrow-right" class="board__tab-icon" />
          </button>
        ))}
      </div>
    </div>

    {niches.map((n, i) => (
      <div class="niche-panel" id={`panel-${n.id}`} data-panel data-active={i === 0 ? 'true' : 'false'}>
        <h3 class="sr-only">{n.tab}</h3>
        <div class="niche-panel__grid">
          <ul class="reels" role="list">
            {n.clips.map((c) => (
              <li class="reel">
                <div class="monitor" data-reel data-src={`/videos/${c.file}.mp4`} data-poster={`/videos/${c.file}.webp`}>
                  <img src={`/videos/${c.file}.webp`} alt={`Still from a client edit: ${c.title}`} width="720" height="1280" loading="lazy" decoding="async" />
                  <button type="button" class="reel__play" data-play>
                    <span class="reel__sq"><Icon name="play" /></span>
                    <span class="reel__meta label">Play · {c.duration}</span>
                    <span class="sr-only">: {c.title}</span>
                  </button>
                </div>
                <p class="reel__title">{c.title}</p>
              </li>
            ))}
          </ul>
          <p class="niche-line">{n.line}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .niches__intro { display: grid; gap: 20px; margin-bottom: clamp(32px, 4vw, 56px); }
  @media (min-width: 1024px) {
    .niches__intro { grid-template-columns: 7fr 5fr; align-items: end; column-gap: 32px; }
  }

  .board {
    padding: clamp(18px, 2.4vw, 32px);
    border: 1px solid var(--g4);
  }
  .board__head { display: grid; gap: 12px; }
  .board__now { color: var(--g2); }
  .flap {
    --size: clamp(15px, calc((100vw - 2 * var(--gutter) - 2 * clamp(18px, 2.4vw, 32px)) / (var(--cells) * 0.97)), 58px);
    display: flex;
    gap: calc(var(--size) * 0.07);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--size);
    line-height: 1;
    perspective: 400px;
  }
  .flap__cell {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--size) * 0.9);
    height: calc(var(--size) * 1.3);
    background: var(--g4);
    overflow: hidden;
  }
  .flap__cell::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: max(1px, calc(var(--size) * 0.03));
    background: var(--ink);
  }
  .flap__ch { display: block; transform-origin: 50% 50%; backface-visibility: hidden; }

  .board__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: clamp(18px, 2.4vw, 28px);
  }
  @media (min-width: 768px) {
    .board__tabs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .board__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 52px;
    padding: 10px 14px;
    border: 1px solid var(--g4);
    background: transparent;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem);
    text-align: left;
    line-height: 1.15;
    transition: background-color 0.2s, color 0.2s;
  }
  .board__tab:hover { border-color: var(--paper); }
  .board__tab[aria-pressed='true'],
  .board__tab[aria-selected='true'] { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .board__tab :global(.board__tab-icon) { width: 18px; height: 18px; opacity: 0; transition: opacity 0.2s, transform 0.3s var(--ease-out); transform: translateX(-4px); }
  .board__tab[aria-pressed='true'] :global(.board__tab-icon),
  .board__tab[aria-selected='true'] :global(.board__tab-icon) { opacity: 1; transform: none; }
  .board__tab:focus-visible { outline-color: var(--paper); }

  .niche-panel { padding-top: clamp(24px, 3vw, 40px); }
  :global(.js) .niche-panel[data-active='false'] { display: none; }
  :global(html:not(.js)) .niche-panel + .niche-panel { border-top: 1px solid var(--g2); margin-top: 24px; }

  .reels {
    list-style: none;
    padding: 4px var(--gutter) 8px;
    margin-inline: calc(-1 * var(--gutter));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72%, 300px);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }
  .reel { scroll-snap-align: start; min-width: 0; }
  @media (min-width: 900px) {
    .niche-panel__grid .niche-line { margin: 0 0 40px; }
    .niche-panel__grid {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(32px, 5vw, 80px);
    }
    .reels {
      margin-inline: 0;
      padding-inline: 0;
      grid-auto-columns: clamp(260px, 24vw, 340px);
      gap: clamp(16px, 2vw, 24px);
      overflow: visible;
    }
  }

  .reel .monitor { cursor: pointer; }
  .reel .monitor img { transition: transform 0.6s var(--ease-out); }
  .reel:hover .monitor img { transform: scale(1.03); }
  .reel__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--paper);
  }
  .reel__sq {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--paper);
    color: var(--ink);
    transition: transform 0.35s var(--ease-out);
  }
  .reel__sq :global(.icon) { width: 22px; height: 22px; }
  .reel__meta {
    display: flex;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    background: var(--ink);
    color: var(--paper);
  }
  .reel:hover .reel__sq { transform: translateY(-4px); }
  .reel:hover .reel__meta { transform: translateY(-4px); transition: transform 0.35s var(--ease-out); }
  .reel__play:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .reel__title {
    margin-top: 12px;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--g4);
  }


  .niche-line {
    margin-top: 24px;
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
</style>
