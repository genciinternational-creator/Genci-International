---
// Founding client strip above the prices. Switched on and off in src/data/site.js (foundingOffer.enabled).
import { foundingOffer } from '../data/site.js';
---
{foundingOffer.enabled && (
  <p class="founding">
    <span class="label founding__label">{foundingOffer.label}</span>
    <span class="founding__text">{foundingOffer.text}</span>
  </p>
)}

<style>
  .founding {
    display: grid;
    gap: 8px;
    margin-bottom: clamp(24px, 3vw, 40px);
    padding: 16px 18px;
    border: 1px solid var(--g4);
  }
  .founding__label { color: var(--g2); }
  .founding__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .founding { grid-template-columns: auto 1fr; align-items: baseline; column-gap: 24px; padding: 18px 24px; }
  }
</style>
