---
// "Who edits your videos": renders only once src/data/site.js has the founder's name and photo.
import { founder, contact } from '../data/site.js';

const ready = Boolean(founder.name && founder.photo);
---
{ready && (
  <section class="founder section" id="team" aria-labelledby="founder-title">
    <div class="wrap founder__grid">
      <div class="founder__photo">
        <img src={founder.photo} alt={`${founder.name}, ${founder.role}`} width="800" height="800" loading="lazy" decoding="async" />
      </div>
      <div class="founder__copy">
        <h2 id="founder-title" class="h2">Who edits your videos.</h2>
        <p class="founder__name">{founder.name}</p>
        <p class="label founder__role">{founder.role}</p>
        {founder.bio && <p class="lede founder__bio">{founder.bio}</p>}
        <p class="founder__direct">
          Questions before you start? Call or text <a class="nobr" href={contact.tel}>{contact.phoneDisplay}</a>.
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .founder__grid { display: grid; gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (min-width: 900px) {
    .founder__grid { grid-template-columns: 5fr 7fr; }
  }
  .founder__photo {
    width: min(100%, 420px);
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    background: var(--g1);
    overflow: hidden;
  }
  /* The portrait follows the monochrome system; color stays reserved for the client videos. */
  .founder__photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .founder__copy { display: grid; gap: 14px; align-content: start; }
  .founder__name {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.1;
  }
  .founder__role { color: var(--g4); }
  .founder__bio { max-width: 52ch; }
  .founder__direct { color: var(--g4); }
  .founder__direct a { color: var(--ink); font-weight: 600; }
</style>
