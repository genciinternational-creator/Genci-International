---
import Icon from './Icon.astro';
import { contact } from '../data/site.js';
---
<nav class="mbar" aria-label="Call or text GENCI">
  <a class="mbar__btn mbar__btn--call" href={contact.tel}><Icon name="phone" /><span>Call</span></a>
  <a class="mbar__btn mbar__btn--text" href={contact.sms}><Icon name="message" /><span>Text</span></a>
</nav>

<style>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ink);
    border-top: 1px solid var(--g4);
  }
  @media (min-width: 768px) { .mbar { display: none; } }
  .mbar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 64px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
  }
  .mbar__btn :global(.icon) { width: 22px; height: 22px; }
  .mbar__btn--call { background: var(--paper); color: var(--ink); }
  .mbar__btn--text { background: var(--ink); color: var(--paper); }
  .mbar__btn--call:focus-visible { outline: 3px solid var(--ink); outline-offset: -6px; }
  .mbar__btn--text:focus-visible { outline: 3px solid var(--paper); outline-offset: -6px; }
</style>
