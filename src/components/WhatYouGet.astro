---
import { included } from '../data/site.js';
---
<section class="get section" id="included" aria-labelledby="get-title">
  <div class="wrap get__grid">
    <div class="get__head">
      <h2 id="get-title" class="h2">What you get back.</h2>
      <p class="lede">Every edit leaves our hands ready to post. Nothing for you to finish in an app.</p>
    </div>
    <dl class="spec">
      {included.map((row) => (
        <div class="spec__row">
          <dt class="label spec__label">{row.label}</dt>
          <dd class="spec__text">
            {row.text}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .get__grid { display: grid; gap: clamp(32px, 5vw, 64px); }
  .get__head { display: grid; gap: 20px; align-content: start; }
  @media (min-width: 1024px) {
    .get__grid { grid-template-columns: 5fr 7fr; }
  }
  .spec { border-top: 1px solid var(--ink); }
  .spec__row {
    display: grid;
    gap: 6px;
    padding-block: 20px;
    border-bottom: 1px solid var(--g2);
  }
  @media (min-width: 640px) {
    .spec__row { grid-template-columns: 11rem 1fr; gap: 24px; align-items: baseline; }
  }
  .spec__label { color: var(--ink); }
  .spec__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.45;
  }
</style>
