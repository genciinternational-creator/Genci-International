---
// Shared frame for the legal pages (privacy policy, terms of service): ink title band, then a reading column.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { title, description, heading, updated } = Astro.props;
---
<Base title={title} description={description} faqSchema={false}>
  <Header home="/" />
  <main id="main" class="policy">
    <div class="policy__band on-dark">
      <div class="wrap">
        <h1 class="policy__title">{heading}</h1>
        <p class="policy__date">Last updated {updated}</p>
      </div>
    </div>

    <div class="wrap">
      <div class="policy__body">
        <slot />

        <a class="btn policy__back" href="/">
          <span class="btn__text">Back to GENCI</span>
          <span class="btn__sq"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .policy__band { padding-block: clamp(40px, 6vw, 88px); }
  .policy__title { font-size: clamp(2.25rem, 1.3rem + 4vw, 4.5rem); }
  .policy__date { margin-top: 12px; color: var(--g2); }
  .policy__body { display: grid; gap: 36px; padding-block: clamp(48px, 6vw, 96px); max-width: 68ch; }
  .policy__body :global(h2) { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); margin-bottom: 10px; }
  .policy__body :global(p) { color: var(--g4); max-width: 68ch; }
  .policy__body :global(p + p) { margin-top: 12px; }
  .policy__body :global(a:not(.btn)) { color: var(--ink); font-weight: 500; }
  .policy__back { justify-self: start; }
</style>
