---
import Icon from './Icon.astro';
import { faq } from '../data/site.js';
---
<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <h2 id="faq-title" class="h2">Questions owners ask first.</h2>
      <p class="faq__web">Need a website too? <a href="#sample">Ask us.</a></p>
    </div>
    <div class="faq__list">
      {faq.map((item) => (
        <details class="qa">
          <summary class="qa__q">
            <span>{item.q}</span>
            <span class="qa__sq" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <div class="qa__a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; gap: clamp(32px, 5vw, 64px); }
  .faq__head { display: grid; gap: 20px; align-content: start; }
  @media (min-width: 1024px) {
    .faq__grid { grid-template-columns: 5fr 7fr; }
  }
  .faq__web { color: var(--g4); }
  .faq__web a { font-weight: 600; color: var(--ink); }

  .faq__list { border-top: 1px solid var(--ink); }
  .qa { border-bottom: 1px solid var(--g2); }
  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 72px;
    padding-block: 16px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .qa__q::-webkit-details-marker { display: none; }
  .qa__sq {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    background: var(--ink);
    color: var(--paper);
  }
  .qa__sq :global(.icon) { width: 18px; height: 18px; transition: transform 0.35s var(--ease-out); }
  .qa[open] .qa__sq :global(.icon) { transform: rotate(45deg); }
  .qa__q:hover .qa__sq { background: var(--g4); }
  .qa__a { padding: 0 56px 24px 0; max-width: 64ch; color: var(--g4); }
</style>
